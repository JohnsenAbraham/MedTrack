# MedTrack Healthcare Management System - Environment Configuration

# Local development mock toggle:
# Set to 'true' for local development without AWS credentials.
# Set to 'false' to connect to live AWS DynamoDB and SNS services.
MOCK_AWS=true

# AWS Configuration (Leave empty or set when MOCK_AWS=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS DynamoDB Table Names
DYNAMODB_USERS_TABLE=MedTrack_Users
DYNAMODB_APPOINTMENTS_TABLE=MedTrack_Appointments
DYNAMODB_DIAGNOSES_TABLE=MedTrack_Diagnoses
DYNAMODB_NOTIFICATIONS_TABLE=MedTrack_Notifications

# AWS SNS Topic ARN (for email / SMS alerts)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:MedTrack-Alerts

# Flask Application Secret Key (generate a strong random string in production)
SECRET_KEY=medtrack-super-secret-key-change-in-production-2026
