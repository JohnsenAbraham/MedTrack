# MedTrack Healthcare Management System - Environment Configuration

# Local development mock toggle:
# Set to 'true' for local development without AWS credentials.
# Set to 'false' to connect to live AWS DynamoDB and SNS services.
MOCK_AWS=true

# Demo Mode toggle (Must remain false in production; set to true only for local evaluator convenience):
DEMO_MODE=false

# Application Timezone (Default: Asia/Kolkata for patient dose schedules)
APP_TIMEZONE=Asia/Kolkata

# AWS Configuration (Production uses EC2 IAM Instance Role; region specified below)
AWS_REGION=us-east-1

# Amazon DynamoDB Table Names (8 Tables)
DYNAMODB_USERS_TABLE=MedTrack_Users
DYNAMODB_MEDICINES_TABLE=MedTrack_Medicines
DYNAMODB_INTAKE_LOGS_TABLE=MedTrack_IntakeLogs
DYNAMODB_APPOINTMENTS_TABLE=MedTrack_Appointments
DYNAMODB_PRESCRIPTIONS_TABLE=MedTrack_Prescriptions
DYNAMODB_DIAGNOSES_TABLE=MedTrack_Diagnoses
DYNAMODB_REPORTS_TABLE=MedTrack_Reports
DYNAMODB_NOTIFICATIONS_TABLE=MedTrack_Notifications

# Amazon SNS Topic ARN (for email / SMS alerts; populated in production via CloudFormation)
SNS_TOPIC_ARN=replace-with-sns-topic-arn

# Amazon S3 Bucket for Medical Reports (Provided by CloudFormation output in production; empty for local storage)
S3_REPORTS_BUCKET=

# Flask Application Security
SECRET_KEY=medtrack-super-secret-key-change-in-production-2026
# Set SESSION_COOKIE_SECURE=true only once HTTPS/TLS is actively configured and operational
SESSION_COOKIE_SECURE=false

# Reverse Proxy & TLS Configuration
# Set USE_PROXY_FIX=true when running behind Nginx / reverse proxy with TLS termination
USE_PROXY_FIX=false

# Optional Domain & Certificate Configuration (Deployment Prerequisites)
# Configure when pointing a registered DNS name to the EC2 host for Certbot or custom certificates:
DOMAIN_NAME=
SSL_CERTIFICATE_PATH=
SSL_CERTIFICATE_KEY_PATH=

